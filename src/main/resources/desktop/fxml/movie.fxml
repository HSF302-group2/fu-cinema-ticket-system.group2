<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox styleClass="page" spacing="16" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fu.cinema.desktop.controller.MovieController">
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Quản lý Phim" styleClass="page-title"/>
            <Label text="Danh sách phim, tìm kiếm, lọc theo thể loại và trạng thái chiếu" styleClass="page-subtitle"/>
        </VBox>
        <Button text="➕ Thêm phim mới" onAction="#onAdd" styleClass="button, primary"/>
    </HBox>

    <!-- Filters Bar -->
    <VBox styleClass="card" spacing="10">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <TextField fx:id="tfSearch" promptText="🔍 Tìm theo tên phim..." prefWidth="250"/>
            <Label text="Thể loại:"/>
            <ComboBox fx:id="cbGenre" prefWidth="160"/>
            <Label text="Trạng thái:"/>
            <ComboBox fx:id="cbStatus" prefWidth="150"/>
            <Label text="Sắp xếp:"/>
            <ComboBox fx:id="cbSort" prefWidth="160"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblCount" text="0 phim" style="-fx-font-weight: bold; -fx-text-fill: #4b5563;"/>
            <Button text="🔄 Làm mới" onAction="#onRefresh" styleClass="button"/>
        </HBox>
    </VBox>

    <!-- Movies Table -->
    <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="10">
        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                <TableColumn fx:id="colTitle" text="Tên phim" prefWidth="240"/>
                <TableColumn fx:id="colGenre" text="Thể loại" prefWidth="130"/>
                <TableColumn fx:id="colDuration" text="Thời lượng" prefWidth="100"/>
                <TableColumn fx:id="colRelease" text="Khởi chiếu" prefWidth="110"/>
                <TableColumn fx:id="colAge" text="Độ tuổi" prefWidth="90"/>
                <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="130"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="12">
            <Button fx:id="btnEdit" text="✏️ Sửa phim" onAction="#onEdit" styleClass="button"/>
            <Button fx:id="btnDelete" text="🗑️ Xoá phim" onAction="#onDelete" styleClass="button, danger"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Pagination fx:id="pagination" maxPageIndicatorCount="7"/>
        </HBox>
    </VBox>
</VBox>
