<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane fx:id="root" hgap="12" vgap="12" style="-fx-padding: 16;" prefWidth="540"
          xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="com.fu.cinema.desktop.controller.MovieDialogController">
    <columnConstraints>
        <ColumnConstraints minWidth="130" prefWidth="130"/>
        <ColumnConstraints hgrow="ALWAYS"/>
    </columnConstraints>

    <Label text="Tên phim (*):" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
    <TextField fx:id="tfTitle" promptText="Nhập tên phim..." GridPane.rowIndex="0" GridPane.columnIndex="1"/>

    <Label text="Đạo diễn (*):" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
    <TextField fx:id="tfDirector" promptText="Tên đạo diễn..." GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <Label text="Thể loại (*):" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
    <ComboBox fx:id="cbGenre" promptText="Chọn thể loại..." maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    <Label text="Thời lượng (phút) (*):" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
    <Spinner fx:id="spDuration" editable="true" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

    <Label text="Ngày khởi chiếu (*):" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
    <DatePicker fx:id="dpRelease" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

    <Label text="Giới hạn độ tuổi (*):" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
    <ComboBox fx:id="cbAgeRating" promptText="Chọn phân loại..." maxWidth="Infinity" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

    <Label text="Trạng thái (*):" GridPane.rowIndex="6" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
    <ComboBox fx:id="cbStatus" promptText="Chọn trạng thái..." maxWidth="Infinity" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

    <Label text="Poster URL (*):" GridPane.rowIndex="7" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
    <TextField fx:id="tfPoster" promptText="https://... hoặc /images/posters/m1.jpg" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

    <Label text="Mô tả nội dung (*):" GridPane.rowIndex="8" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
    <TextArea fx:id="taDescription" promptText="Nội dung tóm tắt của bộ phim..." prefRowCount="4" wrapText="true" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
</GridPane>
